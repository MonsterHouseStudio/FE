# 복사해서 .env 로 사용하세요. (.env 는 커밋 금지)

# true  = 목 데이터로 동작 (백엔드 없이 화면 확인)
# false = /api 프록시를 통해 Spring Boot 호출
VITE_USE_MOCK=true

VITE_API_BASE_URL=/api

# VITE_USE_MOCK=false 일 때 /api 를 넘길 백엔드 주소.
# 8080 이 다른 앱에 점유돼 있으면 BE 를 다른 포트로 띄우고 여기만 바꾸세요.
VITE_API_PROXY_TARGET=http://localhost:8080

# 지도·유튜브 등 공개 키 (노출되어도 되는 값만 VITE_ 접두사 사용)
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@monsterhouse
VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@monsterhouse

# --- Vercel 화면 미리보기 배포용 (백엔드 없이) ---
# Vercel 대시보드의 Environment Variables 에 아래를 넣으세요.
#   VITE_USE_MOCK=true          예시 데이터로 공개 페이지만 시연
#   VITE_API_BASE_URL=/api      (목 모드에서는 사용되지 않음)
#
# 백엔드를 붙인 뒤에는:
#   VITE_USE_MOCK=false
#   VITE_API_BASE_URL=https://실제-백엔드-주소/api
