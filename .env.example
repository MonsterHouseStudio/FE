# 복사해서 .env 로 사용하세요. (.env 는 커밋 금지)

# 목 데이터 사용 여부.
#   true  = 목 데이터로 동작 (백엔드 없이 화면만 확인)
#   그 외 = 실제 API 호출
#
# 기본값이 "끔" 입니다. 이 변수를 빠뜨려도 목으로 뜨지 않습니다 —
# 설정 누락 시 가짜 데이터로 조용히 뜨는 것보다, API 를 못 붙어
# 눈에 띄게 실패하는 편이 안전하기 때문입니다.
VITE_USE_MOCK=false

VITE_API_BASE_URL=/api

# VITE_USE_MOCK 이 true 가 아닐 때 /api 를 넘길 백엔드 주소.
# 8080 이 다른 앱에 점유돼 있으면 BE 를 다른 포트로 띄우고 여기만 바꾸세요.
VITE_API_PROXY_TARGET=http://localhost:8080

# 지도·유튜브 등 공개 키 (노출되어도 되는 값만 VITE_ 접두사 사용)
VITE_YOUTUBE_CHANNEL_URL=https://www.youtube.com/@monsterhouse
VITE_LINE_ADD_FRIEND_URL=https://line.me/R/ti/p/@monsterhouse

# --- 배포 시 (Vercel 등) ---
# Vite 의 환경변수는 빌드 시점에 값이 박힙니다. 재배포로는 안 바뀌고 다시 빌드해야 합니다.
#
# 백엔드를 붙인 운영 배포:
#   VITE_API_BASE_URL=https://실제-백엔드-주소/api
#   (VITE_USE_MOCK 은 넣지 않아도 됩니다 — 기본이 실제 API 입니다)
#
# 백엔드 없이 공개 페이지만 시연할 때만:
#   VITE_USE_MOCK=true
